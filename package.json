{
  "name": "@finstocks/core",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "tokens:build": "node tokens/scripts/build.mjs",
    "tokens:check": "node tokens/scripts/build.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'tokens/test/**/*.test.mjs' 'src/**/*.test.ts'",
    "check": "npm run tokens:check && npm run typecheck && npm run format:check && npm test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./tokens/dist/tokens.css"
  },
  "description": "FinStocks shared core: domain types, market/trading/strategy maths, static data, query keys, endpoint definitions, generated design tokens. Pure TypeScript — consumed by the mobile and web apps.",
  "repository": "github:wrk-singha/finstocks-core",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.3"
  }
}
