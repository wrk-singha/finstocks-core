{
  "name": "@finstocks/core",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "tokens:build": "node tokens/scripts/build.mjs",
    "tokens:check": "node tokens/scripts/build.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'tokens/test/**/*.test.mjs' 'src/**/*.test.ts'",
    "check": "npm run tokens:check && npm run typecheck && npm run lint && npm run format:check && npm test",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./market": "./src/market/index.ts",
    "./market/*": "./src/market/*.ts",
    "./trading": "./src/trading/index.ts",
    "./trading/*": "./src/trading/*.ts",
    "./strategy": "./src/strategy/index.ts",
    "./strategy/*": "./src/strategy/*.ts",
    "./screener": "./src/screener/index.ts",
    "./screener/*": "./src/screener/*.ts",
    "./portfolio": "./src/portfolio/index.ts",
    "./portfolio/*": "./src/portfolio/*.ts",
    "./fundamentals": "./src/fundamentals/index.ts",
    "./fundamentals/*": "./src/fundamentals/*.ts",
    "./data": "./src/data/index.ts",
    "./data/*": "./src/data/*.ts",
    "./format": "./src/format/index.ts",
    "./format/*": "./src/format/*.ts",
    "./queryKeys": "./src/queryKeys.ts",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/*.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./tokens/dist/tokens.css"
  },
  "description": "FinStocks shared core: domain types, market/trading/strategy maths, static data, query keys, endpoint definitions, generated design tokens. Pure TypeScript — consumed by the mobile and web apps.",
  "repository": "github:wrk-singha/finstocks-core",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.3"
  }
}
