{
  "name": "@finstocks/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "tokens:build": "node tokens/scripts/build.mjs",
    "tokens:check": "node tokens/scripts/build.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tokens/test/",
    "check": "pnpm run tokens:check && pnpm run typecheck && pnpm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "prettier": "^3.9.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./tokens/dist/tokens.css"
  },
  "description": "FinStocks shared core: domain types, market/trading/strategy maths, static data, query keys, endpoint definitions, generated design tokens. Pure TypeScript \u2014 consumed by the mobile and web apps.",
  "repository": "github:wrk-singha/finstocks-core",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.3"
  }
}
